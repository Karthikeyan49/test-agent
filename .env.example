# SystemIntel Configuration
# Copy this file to .env and adjust values before running

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: ollama | vllm | openai | disabled
SYSTEMINTEL_AI_PROVIDER=ollama

# For Ollama (local, default):
SYSTEMINTEL_AI_BASE_URL=http://localhost:11434
SYSTEMINTEL_AI_MODEL=qwen3-coder:latest

# For OpenAI-compatible APIs (vLLM, OpenAI, Together.ai, etc.):
# SYSTEMINTEL_AI_BASE_URL=https://api.openai.com
# SYSTEMINTEL_AI_MODEL=gpt-4o
# SYSTEMINTEL_AI_API_KEY=your-api-key-here

# ── HTTP Runner ───────────────────────────────────────────────────────────────
SYSTEMINTEL_HTTP_TIMEOUT=10

# ── Playwright ────────────────────────────────────────────────────────────────
SYSTEMINTEL_HEADLESS=true
SYSTEMINTEL_SCREENSHOTS_DIR=./screenshots
